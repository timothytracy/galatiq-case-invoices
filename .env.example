# Names only. Copy to .env and set the key there. .env is not committed.

XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_MAX_ATTEMPTS=5
# Tool calling is off unless this is 1, true, yes, or on.
XAI_TOOLS=0
# live (default), record, or replay. Replay reads XAI_RECORDING and needs no key.
# XAI_MODE=live
# XAI_RECORDING=recordings/samples.jsonl
